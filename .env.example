# ─── GenAI Model Router Environment Configuration ───

# Google API Key for Gemini 2.5 Flash
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# HuggingFace API Key for Qwen2.5-7B-Instruct
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_API_KEY_HERE

# Target Models
GOOGLE_MODEL=google/gemini-2.5-flash
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Static Length Thresholds
WORD_COUNT_THRESHOLD=10
CHAR_COUNT_THRESHOLD=10

# Backoff & Retry Settings
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=0.5
RETRY_MAX_WAIT_SECONDS=4.0
REQUEST_TIMEOUT_SECONDS=15.0

# Environment Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
